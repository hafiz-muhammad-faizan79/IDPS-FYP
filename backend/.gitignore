# ── Environment & Secrets ──────────────────────────────
.env
.env*
.env.local
.env.*.local
*.pem
*.key

# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── Databases ──────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
postgres-data/

# ── ML Datasets & Trained Models (large files) ─────────
deepdefend/datasets/*.csv
deepdefend/datasets/*.zip
deepdefend/datasets/*.pcap
deepdefend/processed/*.npy
deepdefend/models/*.h5
deepdefend/models/*.keras

# Keep scaler + feature names (small, needed at runtime)
!deepdefend/processed/scaler.pkl
!deepdefend/processed/feature_names.pkl

# ── Runtime / Logs ─────────────────────────────────────
*.log
logs/
*.pid
*.tmp

# ── Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ── Backup files ───────────────────────────────────────
*.backup
*.bak
*~

# ── User uploads (test files) ──────────────────────────
uploads/

# ── Kaggle credentials ────────────────────────────────
.kaggle/
kaggle.json

# Large balanced dataset (regenerable from preprocess.py)
deepdefend/processed/balanced_dataset.csv
